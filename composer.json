{
    "name": "rapttor/yii2-metadata",
    "description": "Yii2 component for per-record metadata kept as JSON in one shared table (key, remote table, remote id): get, set, patch, atomic modify with revision check, history of changed values, export and delete per account.",
    "type": "yii2-extension",
    "keywords": ["yii2", "yii2-extension", "metadata", "settings", "preferences", "json", "history", "gdpr"],
    "homepage": "https://github.com/rapttor/yii2-metadata",
    "license": "MIT",
    "authors": [{"name": "Rapttor", "homepage": "https://rapttor.com"}],
    "support": {
        "issues": "https://github.com/rapttor/yii2-metadata/issues",
        "source": "https://github.com/rapttor/yii2-metadata"
    },
    "require": {
        "php": ">=8.2",
        "yiisoft/yii2": "~2.0.54"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {"psr-4": {"rapttor\\yii2metadata\\": "src/"}},
    "autoload-dev": {"psr-4": {"rapttor\\yii2metadata\\tests\\": "tests/"}},
    "repositories": [{"type": "composer", "url": "https://asset-packagist.org"}],
    "scripts": {"test": "phpunit -c phpunit.xml"},
    "config": {"allow-plugins": {"yiisoft/yii2-composer": true}}
}
